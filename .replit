modules = ["web", "nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd pale_array_site/dist && http-server -p 5000 -a 0.0.0.0 --cors"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 32825
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["http-server", "pale_array_site/dist", "-p", "5000", "-a", "0.0.0.0"]
build = ["npm", "run", "build"]
